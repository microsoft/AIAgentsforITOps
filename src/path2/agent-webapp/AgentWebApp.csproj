<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>AgentWebApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure SDK packages for Path 2: Foundry-hosted prompt agent -->
    <!-- The UI is a thin client: it calls a Foundry prompt agent over the OpenAI -->
    <!-- Responses API. The agent already owns the instructions, model, and -->
    <!-- knowledge base, so only Azure.Identity (for the bearer token) is needed. -->
    <PackageReference Include="Azure.Identity" Version="1.19.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.3.0" />

    <!-- Swagger/OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

</Project>
